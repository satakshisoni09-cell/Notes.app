<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Note</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container mt-5" style="max-width: 600px;">
        <h2 class="mb-4">Edit Note</h2>
        <div class="d-flex gap-2">
        <form action="/notes/<%= note._id %>/edit" method="POST">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input value="<%= note.title %>" class="form-control" id="title" name="title" required>
            </div>
            <div class="mb-3">
                <label for="content" class="form-label">Content</label>
                <textarea class="form-control" id="content" name="content" rows="5" required><%= note.content %></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Update Note</button>
            <a href="/notes" class="btn btn-outline-secondary ms-2">Back</a>
        </form>
    </div>
    </div>
</body>
</html>