<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Notes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container mt-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">My Notes</h1>
            <div class="d-flex gap-2">
                <a href="/notes/new" class="btn btn-primary">New Note</a>
                <a href="/user/logout" class="btn btn-outline-secondary">Logout</a>
            </div>
        </div>

        <% if (notes.length === 0) { %>
            <p class="text-muted">No notes added yet</p>
        <% } %>

        <div class="row g-3">
            <% notes.forEach(note => { %>
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title"><%= note.title %></h5>
                            <p class="card-text"><%= note.content %></p>
                            <div class="d-flex gap-2">
                                <a href="/notes/<%= note._id %>/edit" class="btn btn-warning btn-sm">Edit</a>
                                <form action="/notes/<%= note._id %>/delete" method="POST">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

    </div>
</body>
</html>